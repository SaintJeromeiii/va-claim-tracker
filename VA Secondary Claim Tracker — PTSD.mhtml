@charset "utf-8";

:root { --ink: #142033; --ink-soft: #3d4a5c; --line: #d5dde8; --paper: #f7f=
5f1; --card: #ffffff; --navy: #1e3a5f; --navy-deep: #132848; --accent: #2f6=
f5e; --accent-soft: #e6f1ed; --warn: #8a5a2b; --warn-soft: #faf6f0; --dange=
r: #8b3a3a; --radius: 10px; --shadow: 0 1px 0 rgba(20, 32, 51, 0.04); --fon=
t: "IBM Plex Sans", system-ui, sans-serif; --display: "IBM Plex Serif", Geo=
rgia, serif; }

* { box-sizing: border-box; }

html { scroll-behavior: smooth; }

body { margin: 0px; font-family: var(--font); color: var(--ink); background=
: radial-gradient(1200px 500px at 10% -10%, #e8eef6 0%, transparent 55%),
        radial-gradient(900px 400px at 100% 0%, #e7f0ec 0%, transparent 50%=
),
        var(--paper); line-height: 1.45; }

a { color: var(--navy); }

header.app-header { background: linear-gradient(135deg, var(--navy-deep), v=
ar(--navy)); color: rgb(244, 247, 251); padding: 28px 20px 22px; }

.wrap { max-width: 1100px; margin: 0px auto; padding: 0px 16px; }

header h1 { font-family: var(--display); font-size: clamp(1.55rem, 3vw, 2re=
m); font-weight: 600; margin: 0px 0px 8px; letter-spacing: -0.02em; }

